{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "rm -rf build && yarn build && yarn gh-pages -d build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "eslint": "eslint --fix . --quiet",
    "prettify": "yarn prettier --write docs/ --loglevel warn --config ./.prettiermarkdownrc",
    "markdownlint": "markdownlint --fix docs/",
    "lint": "yarn eslint && yarn prettify && yarn markdownlint",
    "prepare": "husky install"
  },
  "dependencies": {
    "@docusaurus/core": "2.0.0-beta.21",
    "@docusaurus/preset-classic": "2.0.0-beta.21",
    "@mdx-js/react": "^1.6.22",
    "clsx": "^1.1.1",
    "prism-react-renderer": "^1.3.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "yarn": "^1.22.19"
  },
  "devDependencies": {
    "@cmfcmf/docusaurus-search-local": "^0.10.0",
    "@docusaurus/eslint-plugin": "^2.0.0-beta.21",
    "@docusaurus/module-type-aliases": "2.0.0-beta.21",
    "@tsconfig/docusaurus": "^1.0.5",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-markdown": "^2.2.1",
    "eslint-plugin-prettier": "^4.0.0",
    "gh-pages": "^4.0.0",
    "husky": "^8.0.1",
    "markdownlint": "^0.25.1",
    "prettier": "^2.7.0",
    "typescript": "^4.6.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
